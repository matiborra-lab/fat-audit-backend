# Copiar este archivo a ".env" y completar los valores reales.
# El archivo ".env" NUNCA se sube a GitHub (ya deberia estar en .gitignore).

# Base de datos Postgres (te la da Neon/Railway/Render automaticamente al crearla)
DATABASE_URL=postgres://usuario:password@host:5432/nombre_basededatos

# Puerto en el que corre el servidor (Railway/Render lo asignan solos, dejar así)
PORT=3000

# Clave secreta para firmar las sesiones de usuario - generarla una vez con:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# URL publica del frontend, para armar los links de los mails de invitacion
# y de reseteo de contraseña (ej: https://app.fataudit.com.ar)
FRONTEND_URL=http://localhost:5173

# Para enviar los mails de invitacion/reseteo de contraseña (registrate gratis en resend.com)
RESEND_API_KEY=
MAIL_FROM=FAT Audit <no-responder@fataudit.com.ar>

# Storage de evidencia (fotos/video) - bucket S3-compatible, ej Cloudflare R2
# (cuenta gratis en dash.cloudflare.com > R2). ENDPOINT es el de tu cuenta R2,
# BUCKET el nombre que le pongas al bucket, PUBLIC_URL el dominio publico que
# le conectes (o el subdominio r2.dev que da Cloudflare).
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=fat-audit-evidencia
S3_PUBLIC_URL=
